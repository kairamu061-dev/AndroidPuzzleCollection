{
  "name": "Android Puzzle Collection",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "claudeuser",
  "mounts": [
    "source=${localEnv:USERPROFILE}/.claude,target=/home/claudeuser/.claude,type=bind",
    "source=android-puzzle-gradle-cache,target=/home/claudeuser/.gradle,type=volume",
    "source=android-puzzle-gh-config,target=/home/claudeuser/.config/gh,type=volume"
  ],
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}"
}
